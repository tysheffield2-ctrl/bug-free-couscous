{
  "name": "encore-artist-sim",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "encore-saves"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "tysheffield2@icloud.com"
    }
  ],
  "vars": {
    "FEEDBACK_TO": "tysheffield2@icloud.com",
    "FEEDBACK_FROM": "feedback@encoremusicsim.com"
  }
}
